{
  "name": "sfx-toolkit",
  "displayName": "Adure SFX Toolkit",
  "publisher": "AdureIO",
  "description": "Utilities for Salesforce development: Log filtering, Debug Traces, Deployment, and more.",
  "icon": "resources/icon.png",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdureIO/SFX-Toolkit.git"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/AdureIO"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "salesforce",
    "sfdx",
    "apex",
    "soql",
    "logs",
    "debug",
    "deployment",
    "toolkit"
  ],
  "activationEvents": [
    "workspaceContains:sfdx-project.json",
    "onCustomEditor:adure-sfx-toolkit.permissionSetEditor",
    "onCustomEditor:adure-sfx-toolkit.scratchOrgDefEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adure-sfx-toolkit.filterLogDebug",
        "title": "ASFXT: Filter Debug",
        "icon": {
          "light": "resources/light/debug-inactive.svg",
          "dark": "resources/dark/debug-inactive.svg"
        }
      },
      {
        "command": "adure-sfx-toolkit.filterLogDebugActive",
        "title": "ASFXT: Filter Debug (Active)",
        "icon": {
          "light": "resources/light/debug-active.svg",
          "dark": "resources/dark/debug-active.svg"
        }
      },
      {
        "command": "adure-sfx-toolkit.filterLogSOQL",
        "title": "ASFXT: Filter SOQL/DML",
        "icon": {
          "light": "resources/light/soql-inactive.svg",
          "dark": "resources/dark/soql-inactive.svg"
        }
      },
      {
        "command": "adure-sfx-toolkit.filterLogSOQLActive",
        "title": "ASFXT: Filter SOQL/DML (Active)",
        "icon": {
          "light": "resources/light/soql-active.svg",
          "dark": "resources/dark/soql-active.svg"
        }
      },
      {
        "command": "adure-sfx-toolkit.refreshLogs",
        "title": "ASFXT: Refresh Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "adure-sfx-toolkit.openLog",
        "title": "ASFXT: Open Log"
      },
      {
        "command": "adure-sfx-toolkit.listLogs",
        "title": "ASFXT: List and Open Logs"
      },
      {
        "command": "adure-sfx-toolkit.addDebugTrace",
        "title": "ASFXT: New Trace",
        "icon": "$(plus)"
      },
      {
        "command": "adure-sfx-toolkit.quickTrace",
        "title": "ASFXT: Quick Trace (Current User)",
        "icon": "$(zap)"
      },
      {
        "command": "adure-sfx-toolkit.deleteAllLogs",
        "title": "ASFXT: Delete All Logs",
        "icon": "$(trash)"
      },
      {
        "command": "adure-sfx-toolkit.deleteTrace",
        "title": "ASFXT: Delete Trace",
        "icon": "$(trash)"
      },
      {
        "command": "adure-sfx-toolkit.refreshTraces",
        "title": "ASFXT: Refresh Traces",
        "icon": "$(refresh)"
      },
      {
        "command": "adure-sfx-toolkit.deployMetadata",
        "title": "ASFXT: Deploy Metadata"
      },
      {
        "command": "adure-sfx-toolkit.executeAnonymous",
        "title": "ASFXT: Execute Anonymous Apex",
        "icon": "$(play)"
      },
      {
        "command": "adure-sfx-toolkit.rerunLastApex",
        "title": "ASFXT: Rerun Last Apex",
        "icon": "$(debug-restart)"
      },
      {
        "command": "adure-sfx-toolkit.executeSOQL",
        "title": "ASFXT: Execute SOQL Query"
      },
      {
        "command": "adure-sfx-toolkit.refreshOrgs",
        "title": "ASFXT: Refresh Orgs",
        "icon": "$(refresh)"
      },
      {
        "command": "adure-sfx-toolkit.openOrg",
        "title": "ASFXT: Open Org",
        "icon": "$(globe)"
      },
      {
        "command": "adure-sfx-toolkit.setAsDefaultOrg",
        "title": "ASFXT: Set as Default",
        "icon": "$(check)"
      },
      {
        "command": "adure-sfx-toolkit.setAsDefaultDevHub",
        "title": "ASFXT: Set as Default Dev Hub",
        "icon": "$(star-empty)"
      },
      {
        "command": "adure-sfx-toolkit.copyUsername",
        "title": "ASFXT: Copy Username",
        "icon": "$(copy)"
      },
      {
        "command": "adure-sfx-toolkit.renameAlias",
        "title": "ASFXT: Rename Alias",
        "icon": "$(edit)"
      },
      {
        "command": "adure-sfx-toolkit.generatePassword",
        "title": "ASFXT: Generate Password",
        "icon": "$(key)"
      },
      {
        "command": "adure-sfx-toolkit.deleteOrg",
        "title": "ASFXT: Delete/Logout",
        "icon": "$(trash)"
      },
      {
        "command": "adure-sfx-toolkit.connectOrg",
        "title": "ASFXT: Connect Org",
        "icon": "$(plug)"
      },
      {
        "command": "adure-sfx-toolkit.openPermissionSetUI",
        "title": "ASFXT: Open in Permission UI",
        "icon": "$(edit)"
      },
      {
        "command": "adure-sfx-toolkit.createScratch",
        "title": "ASFXT: Create Scratch Org",
        "icon": "$(beaker)"
      },
      {
        "command": "adure-sfx-toolkit.quickScratch",
        "title": "ASFXT: Quick Scratch (Defaults)",
        "icon": "$(rocket)"
      },
      {
        "command": "adure-sfx-toolkit.pushSource",
        "title": "ASFXT: Push Source",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "adure-sfx-toolkit.pushSourceForce",
        "title": "ASFXT: Push Source (Force/Override)",
        "icon": "$(alert)"
      },
      {
        "command": "adure-sfx-toolkit.pullSource",
        "title": "ASFXT: Pull Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "adure-sfx-toolkit.pullSourceForce",
        "title": "ASFXT: Pull Source (Force/Override)",
        "icon": "$(alert)"
      },
      {
        "command": "adure-sfx-toolkit.deployCurrentFile",
        "title": "ASFXT: Deploy Current File"
      },
      {
        "command": "adure-sfx-toolkit.retrieveCurrentFile",
        "title": "ASFXT: Retrieve Current File"
      },
      {
        "command": "adure-sfx-toolkit.validateApexFile",
        "title": "ASFXT: Validate Apex Against Org",
        "icon": "$(check-all)"
      },
      {
        "command": "adure-sfx-toolkit.resetSourceTracking",
        "title": "ASFXT: Reset Source Tracking",
        "icon": "$(history)"
      },
      {
        "command": "adure-sfx-toolkit.refreshMetadata",
        "title": "ASFXT: Refresh Org Metadata Cache",
        "icon": "$(refresh)"
      },
      {
        "command": "adure-sfx-toolkit.openSOQLEditor",
        "title": "ASFXT: Open SOQL Builder & Editor",
        "icon": "$(database)"
      },
      {
        "command": "adure-sfx-toolkit.metadataDiff",
        "title": "ASFXT: Compare with Org"
      },
      {
        "command": "adure-sfx-toolkit.orgHealth",
        "title": "ASFXT: Org Health Dashboard"
      },
      {
        "command": "adure-sfx-toolkit.quickSoql",
        "title": "ASFXT: Quick SOQL from Selection"
      },
      {
        "command": "adure-sfx-toolkit.deployHistory",
        "title": "ASFXT: Deployment History"
      },
      {
        "command": "adure-sfx-toolkit.addToGitignore",
        "title": "ASFXT: Add to .gitignore"
      },
      {
        "command": "adure-sfx-toolkit.addToForceignore",
        "title": "ASFXT: Add to .forceignore"
      },
      {
        "command": "adure-sfx-toolkit.addToIgnore",
        "title": "ASFXT: Add to Ignore File..."
      },
      {
        "command": "adure-sfx-toolkit.showSnippets",
        "title": "ASFXT: Apex Snippets",
        "icon": "$(play)"
      },
      {
        "command": "adure-sfx-toolkit.openSnippetsPanel",
        "title": "ASFXT: Open Apex Snippets Overview",
        "icon": "$(list-unordered)"
      },
      {
        "command": "adure-sfx-toolkit.runSnippet",
        "title": "ASFXT: Run Apex Snippet (default org)",
        "icon": "$(play)"
      },
      {
        "command": "adure-sfx-toolkit.runSnippetFromTree",
        "title": "ASFXT: Run Apex Snippet (select org)",
        "icon": "$(play)"
      },
      {
        "command": "adure-sfx-toolkit.addSnippet",
        "title": "ASFXT: Add Apex Snippet",
        "icon": "$(plus)"
      },
      {
        "command": "adure-sfx-toolkit.deleteSnippet",
        "title": "ASFXT: Delete Apex Snippet",
        "icon": "$(trash)"
      },
      {
        "command": "adure-sfx-toolkit.editSnippetFile",
        "title": "ASFXT: Open Snippets Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "adure-sfx-toolkit.editSnippet",
        "title": "ASFXT: Edit Snippet in .apex File",
        "icon": "$(edit)"
      },
      {
        "command": "adure-sfx-toolkit.refreshSnippets",
        "title": "ASFXT: Refresh Snippets",
        "icon": "$(refresh)"
      },
      {
        "command": "adure-sfx-toolkit.lwcNavigate",
        "title": "ASFXT: LWC Navigate to Sibling",
        "icon": "$(files)"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToJs",
        "title": "ASFXT: LWC: Open JS",
        "icon": "$(file-code)"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToHtml",
        "title": "ASFXT: LWC: Open HTML",
        "icon": "$(code)"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToMeta",
        "title": "ASFXT: LWC: Open Meta XML",
        "icon": "$(settings-gear)"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToCss",
        "title": "ASFXT: LWC: Open CSS",
        "icon": "$(paintcan)"
      },
      {
        "command": "adure-sfx-toolkit.dataTools",
        "title": "ASFXT: Data Export / Import",
        "icon": "$(database)"
      },
      {
        "command": "adure-sfx-toolkit.restExplorer",
        "title": "ASFXT: REST API Explorer",
        "icon": "$(plug)"
      },
      {
        "command": "adure-sfx-toolkit.dataMigration",
        "title": "ASFXT: Data Migration Wizard",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "adure-sfx-toolkit.openPackageExplorer",
        "title": "ASFXT: Package Explorer (Dev Hub)",
        "icon": "$(package)"
      },
      {
        "command": "adure-sfx-toolkit.listInstalledPackages",
        "title": "ASFXT: List Installed Packages",
        "icon": "$(package)"
      },
      {
        "command": "adure-sfx-toolkit.openApexCoverage",
        "title": "ASFXT: Apex Coverage",
        "icon": "$(shield)"
      },
      {
        "command": "adure-sfx-toolkit.refreshApexCoverage",
        "title": "ASFXT: Refresh Apex Coverage",
        "icon": "$(refresh)"
      },
      {
        "command": "adure-sfx-toolkit.toggleApexCoverageLines",
        "title": "ASFXT: Toggle Apex Coverage Line Highlights",
        "icon": "$(list-selection)"
      },
      {
        "command": "adure-sfx-toolkit.toggleApexCoverageBadge",
        "title": "ASFXT: Toggle Apex Coverage % Badge (Explorer)",
        "icon": "$(eye)"
      },
      {
        "command": "adure-sfx-toolkit.clearApexTestResults",
        "title": "ASFXT: Clear Apex Test Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "adure-sfx-toolkit.toggleHideMetaXml",
        "title": "ASFXT: Toggle Hide Apex -meta.xml Files",
        "icon": "$(eye-closed)"
      },
      {
        "command": "adure-sfx-toolkit.openApexTests",
        "title": "ASFXT: Open Apex Tests (Test Explorer)",
        "category": "Adure SFX Toolkit"
      }
    ],
    "languages": [
      {
        "id": "salesforce-log",
        "aliases": [
          "Salesforce Log",
          "sf-log"
        ],
        "extensions": [
          ".log"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "soql",
        "aliases": [
          "SOQL"
        ],
        "extensions": [
          ".soql"
        ]
      }
    ],
    "grammars": [
      {
        "language": "salesforce-log",
        "scopeName": "source.salesforce-log",
        "path": "./syntaxes/salesforce-log.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adure-sfx-toolkit-activitybar",
          "title": "Adure SFX Toolkit",
          "icon": "resources/dark/sidebar.png"
        }
      ],
      "panel": [
        {
          "id": "adure-sfx-toolkit-workbench",
          "title": "ASFX Workbench",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "adure-sfx-toolkit-activitybar": [
        {
          "id": "adure-sfx-toolkit.logs",
          "name": "Logs",
          "when": "adure-sfx-toolkit:isSalesforceProject",
          "visibility": "collapsed"
        },
        {
          "id": "adure-sfx-toolkit.traces",
          "name": "Debug Traces",
          "when": "adure-sfx-toolkit:isSalesforceProject",
          "visibility": "collapsed"
        },
        {
          "id": "adure-sfx-toolkit.orgs",
          "name": "Orgs",
          "when": "adure-sfx-toolkit:isSalesforceProject"
        },
        {
          "id": "adure-sfx-toolkit.development",
          "name": "Development",
          "when": "adure-sfx-toolkit:isSalesforceProject"
        },
        {
          "id": "adure-sfx-toolkit.snippets",
          "name": "Apex Snippets",
          "when": "adure-sfx-toolkit:isSalesforceProject"
        }
      ],
      "adure-sfx-toolkit-workbench": [
        {
          "type": "webview",
          "id": "adure-sfx-toolkit.apexWorkbench",
          "name": "ASFX Workbench",
          "when": "adure-sfx-toolkit:isSalesforceProject"
        }
      ]
    },
    "keybindings": [
      {
        "command": "adure-sfx-toolkit.executeAnonymous",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceExtname == .apex"
      },
      {
        "command": "adure-sfx-toolkit.filterLogDebug",
        "key": "cmd+d",
        "mac": "cmd+d",
        "win": "ctrl+d",
        "linux": "ctrl+d",
        "when": "editorTextFocus && adure-sfx-toolkit:isLogFile"
      },
      {
        "command": "adure-sfx-toolkit.lwcNavigate",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "editorTextFocus && resourcePath =~ /.*[/\\\\]lwc[/\\\\]/"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToJs",
        "key": "alt+1",
        "mac": "alt+1",
        "when": "editorTextFocus && resourcePath =~ /.*[/\\\\]lwc[/\\\\]/"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToHtml",
        "key": "alt+2",
        "mac": "alt+2",
        "when": "editorTextFocus && resourcePath =~ /.*[/\\\\]lwc[/\\\\]/"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToMeta",
        "key": "alt+3",
        "mac": "alt+3",
        "when": "editorTextFocus && resourcePath =~ /.*[/\\\\]lwc[/\\\\]/"
      },
      {
        "command": "adure-sfx-toolkit.lwcGoToCss",
        "key": "alt+4",
        "mac": "alt+4",
        "when": "editorTextFocus && resourcePath =~ /.*[/\\\\]lwc[/\\\\]/"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "adure-sfx-toolkit.refreshLogs",
          "when": "view == adure-sfx-toolkit.logs",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.deleteAllLogs",
          "when": "view == adure-sfx-toolkit.logs",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.refreshTraces",
          "when": "view == adure-sfx-toolkit.traces",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.quickTrace",
          "when": "view == adure-sfx-toolkit.traces",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.addDebugTrace",
          "when": "view == adure-sfx-toolkit.traces",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.refreshSnippets",
          "when": "view == adure-sfx-toolkit.snippets",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.addSnippet",
          "when": "view == adure-sfx-toolkit.snippets",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.editSnippetFile",
          "when": "view == adure-sfx-toolkit.snippets",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.refreshOrgs",
          "when": "view == adure-sfx-toolkit.orgs",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.connectOrg",
          "when": "view == adure-sfx-toolkit.orgs",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.createScratch",
          "when": "view == adure-sfx-toolkit.orgs",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.quickScratch",
          "when": "view == adure-sfx-toolkit.orgs",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.deployMetadata",
          "when": "view == adure-sfx-toolkit.development",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.retrieveCurrentFile",
          "when": "view == adure-sfx-toolkit.development",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.resetSourceTracking",
          "when": "view == adure-sfx-toolkit.development",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.openSOQLEditor",
          "when": "view == adure-sfx-toolkit.development",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.dataTools",
          "when": "view == adure-sfx-toolkit.development",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.restExplorer",
          "when": "view == adure-sfx-toolkit.development",
          "group": "navigation"
        },
        {
          "command": "adure-sfx-toolkit.dataMigration",
          "when": "view == adure-sfx-toolkit.development",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adure-sfx-toolkit.deleteTrace",
          "when": "view == adure-sfx-toolkit.traces",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.runSnippetFromTree",
          "when": "view == adure-sfx-toolkit.snippets && viewItem == snippetItem",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.editSnippet",
          "when": "view == adure-sfx-toolkit.snippets && viewItem == snippetItem",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.deleteSnippet",
          "when": "view == adure-sfx-toolkit.snippets && viewItem == snippetItem",
          "group": "1_modify"
        },
        {
          "command": "adure-sfx-toolkit.openOrg",
          "when": "view == adure-sfx-toolkit.orgs && viewItem =~ /org-*/",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.setAsDefaultOrg",
          "when": "view == adure-sfx-toolkit.orgs && viewItem =~ /org-*/",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.setAsDefaultDevHub",
          "when": "view == adure-sfx-toolkit.orgs && viewItem == org-devhub",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.openPackageExplorer",
          "when": "view == adure-sfx-toolkit.orgs && viewItem == org-devhub",
          "group": "inline"
        },
        {
          "command": "adure-sfx-toolkit.openPackageExplorer",
          "when": "view == adure-sfx-toolkit.orgs && viewItem == org-devhub",
          "group": "2_copy"
        },
        {
          "command": "adure-sfx-toolkit.listInstalledPackages",
          "when": "view == adure-sfx-toolkit.orgs && viewItem =~ /^org-/",
          "group": "2_copy"
        },
        {
          "command": "adure-sfx-toolkit.renameAlias",
          "when": "view == adure-sfx-toolkit.orgs && viewItem =~ /org-*/",
          "group": "1_modify"
        },
        {
          "command": "adure-sfx-toolkit.generatePassword",
          "when": "view == adure-sfx-toolkit.orgs && viewItem =~ /org-*/",
          "group": "1_modify"
        },
        {
          "command": "adure-sfx-toolkit.copyUsername",
          "when": "view == adure-sfx-toolkit.orgs && viewItem =~ /org-*/",
          "group": "2_copy"
        },
        {
          "command": "adure-sfx-toolkit.deleteOrg",
          "when": "view == adure-sfx-toolkit.orgs && viewItem == org-scratch",
          "group": "3_danger"
        },
        {
          "command": "adure-sfx-toolkit.deleteOrg",
          "when": "view == adure-sfx-toolkit.orgs && (viewItem == org-connected || viewItem == org-devhub)",
          "group": "3_danger"
        }
      ],
      "editor/title": [
        {
          "command": "adure-sfx-toolkit.executeAnonymous",
          "when": "resourceLangId == apex",
          "group": "navigation@1"
        },
        {
          "command": "adure-sfx-toolkit.validateApexFile",
          "when": "resourceExtname == .cls || resourceExtname == .trigger",
          "group": "navigation@2"
        },
        {
          "command": "adure-sfx-toolkit.rerunLastApex",
          "when": "resourceScheme == sf-anon-log",
          "group": "navigation@1"
        },
        {
          "command": "adure-sfx-toolkit.filterLogDebug",
          "when": "(resourceScheme == sf-log || resourceScheme == sf-anon-log) && !adure-sfx-toolkit:filterDebug",
          "group": "navigation@2"
        },
        {
          "command": "adure-sfx-toolkit.filterLogDebugActive",
          "when": "(resourceScheme == sf-log || resourceScheme == sf-anon-log) && adure-sfx-toolkit:filterDebug",
          "group": "navigation@2"
        },
        {
          "command": "adure-sfx-toolkit.filterLogSOQL",
          "when": "(resourceScheme == sf-log || resourceScheme == sf-anon-log) && !adure-sfx-toolkit:filterSOQL",
          "group": "navigation@3"
        },
        {
          "command": "adure-sfx-toolkit.filterLogSOQLActive",
          "when": "(resourceScheme == sf-log || resourceScheme == sf-anon-log) && adure-sfx-toolkit:filterSOQL",
          "group": "navigation@3"
        },
        {
          "command": "adure-sfx-toolkit.openPermissionSetUI",
          "when": "resourceFilename =~ /\\.permissionset-meta\\.xml$/",
          "group": "navigation@4"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToJs",
          "when": "adure-sfx-toolkit:lwcHasJs",
          "group": "navigation@10"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToHtml",
          "when": "adure-sfx-toolkit:lwcHasHtml",
          "group": "navigation@11"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToCss",
          "when": "adure-sfx-toolkit:lwcHasCss",
          "group": "navigation@12"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToMeta",
          "when": "adure-sfx-toolkit:lwcHasMeta",
          "group": "navigation@13"
        }
      ],
      "explorer/context": [
        {
          "command": "adure-sfx-toolkit.addToGitignore",
          "when": "adure-sfx-toolkit:isSalesforceProject",
          "group": "7_modification@1"
        },
        {
          "command": "adure-sfx-toolkit.addToForceignore",
          "when": "adure-sfx-toolkit:isSalesforceProject",
          "group": "7_modification@2"
        }
      ],
      "commandPalette": [
        {
          "command": "adure-sfx-toolkit.filterLogDebug",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.filterLogDebugActive",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.filterLogSOQL",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.filterLogSOQLActive",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToJs",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToHtml",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToMeta",
          "when": "false"
        },
        {
          "command": "adure-sfx-toolkit.lwcGoToCss",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "adure-sfx-toolkit.permissionSetEditor",
        "displayName": "Permission Set Editor",
        "selector": [
          {
            "filenamePattern": "*.permissionset-meta.xml"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "adure-sfx-toolkit.scratchOrgDefEditor",
        "displayName": "Scratch Org Definition Editor",
        "selector": [
          {
            "filenamePattern": "*-scratch-def.json"
          },
          {
            "filenamePattern": "project-scratch-def.json"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Adure SFX Toolkit",
      "properties": {
        "adure-sfx-toolkit.liveLogIntervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 60,
          "description": "How often (seconds) the log views refresh while live — i.e. while a debug trace is active. Logs are not polled when no trace is active."
        },
        "adure-sfx-toolkit.maxLogFiles": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 200,
          "description": "Maximum number of log files to fetch when polling."
        },
        "adure-sfx-toolkit.quickTraceDurationMinutes": {
          "type": "number",
          "default": 240,
          "minimum": 1,
          "maximum": 1440,
          "description": "Duration in minutes for Quick Trace."
        },
        "adure-sfx-toolkit.quickTraceDebugLevel": {
          "type": "string",
          "default": "SFDC_DevConsole",
          "description": "Debug level name for Quick Trace."
        },
        "adure-sfx-toolkit.toolingApiVersion": {
          "type": "string",
          "default": "v67.0",
          "description": "Salesforce Tooling API version."
        },
        "adure-sfx-toolkit.apexLog.highlightPatterns": {
          "type": "array",
          "scope": "resource",
          "markdownDescription": "Line-highlighting rules for Salesforce debug logs (`.log` files and the Execute Apex results pane). Each rule is a regular expression with a color and optional style. Order matters: the first matching rule wins for a line.",
          "default": [
            {
              "pattern": "\\|FATAL_ERROR\\|.*",
              "foreground": "#f64b4b",
              "highlightEntireLine": true
            },
            {
              "pattern": "\\|EXCEPTION_THROWN\\|.*",
              "foreground": "#f64b4b",
              "highlightEntireLine": true
            },
            {
              "pattern": "\\|USER_DEBUG\\|.*",
              "foreground": "#6c64ff",
              "fontStyle": "bold",
              "highlightEntireLine": true
            },
            {
              "pattern": "\\|SOQL_EXECUTE_BEGIN\\|.*",
              "foreground": "#15d274",
              "fontStyle": "bold",
              "highlightEntireLine": true
            },
            {
              "pattern": "\\|DML_BEGIN\\|.*",
              "foreground": "#e2c08d",
              "fontStyle": "bold",
              "highlightEntireLine": true
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "pattern"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regular expression matched against each log line."
              },
              "foreground": {
                "type": "string",
                "description": "Text color (hex, e.g. #f64b4b)."
              },
              "fontStyle": {
                "type": "string",
                "enum": [
                  "normal",
                  "bold",
                  "italic",
                  "bold italic"
                ],
                "description": "Font style for matched text."
              },
              "highlightEntireLine": {
                "type": "boolean",
                "default": false,
                "description": "Color the whole line rather than only the matched text."
              }
            }
          }
        },
        "adure-sfx-toolkit.soql.enableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable org-aware SOQL code completion (objects, fields, relationships, subqueries, picklist values) in .soql files."
        },
        "adure-sfx-toolkit.apex.languageServer": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "on",
          "markdownDescription": "Apex *semantic* features (outline, syntax diagnostics, go-to-definition for your own classes, signature help) from the SFX language server. `on` (default): always enabled. `auto`: enabled only when the official Salesforce Apex extension is not installed (avoids duplicates). `off`: disabled."
        },
        "adure-sfx-toolkit.apex.enableCompletion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Org-aware Apex code completion (SObject fields on `var.`, `new` constructors, and SObject type names). This is additive to the Salesforce Apex extension. Turn **off** if you see duplicate suggestions and prefer the Salesforce extension's completion."
        },
        "adure-sfx-toolkit.apex.validateSemantics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offline schema validation: flag `variable.Field` accesses whose field or relationship does not exist on the SObject, checked against cached org metadata (no org round-trip). Warnings appear as you open/save Apex files. Conservative — only flags members it can confidently resolve. Requires Apex semantic features (`apex.languageServer` not `off`)."
        },
        "adure-sfx-toolkit.deploy.liveStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In the **Deploy Metadata** panel, show live status by polling the Metadata REST API for structured progress (stage, components X/Y, tests X/Y) and routing failures to the Problems view. Turn **off** to stream the classic `sf project deploy start` CLI output instead. (Push/Pull always run a synchronous deploy so source tracking stays correct — this setting does not affect them.)"
        },
        "adure-sfx-toolkit.apex.validateOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "On save, validate the Apex file against the default org with a check-only (dry-run) deploy and show compiler errors in the Problems view. Authoritative (catches type/reference errors the offline check cannot) but performs an org round-trip on every save, so it is **off by default**. Also available on demand via **ASFXT: Validate Apex Against Org**."
        },
        "adure-sfx-toolkit.apex.autoRestartLanguageServer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "After generating/updating SObject stubs, restart the Salesforce Apex Language Server. **Off by default and not recommended:** the Salesforce LS already picks up stub-file changes incrementally via its file watcher, and restarting on large change sets can trigger a Salesforce indexer crash. Enable only if you specifically need a forced re-index. Throttled to once every 30s."
        },
        "adure-sfx-toolkit.apex.restartAfterInitialLoad": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Once, after the Salesforce Apex Language Server finishes its initial load, perform a single clean restart so the SObject stubs generated this session are indexed and the new types are available. Waits for loading to complete (never restarts mid-index) and runs at most once per session. Requires the Salesforce Apex extension and stub generation."
        },
        "adure-sfx-toolkit.apex.monitorLanguageServer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Watch the Salesforce Apex Language Server and, if it crashes and stays down (after its own retries), perform a **clean restart** (reset the Apex DB) to recover from DB corruption. Bounded to 2 attempts — if it still fails, shows an error and stops (no restart loop). Requires the Salesforce Apex extension."
        },
        "adure-sfx-toolkit.apex.stubScope": {
          "type": "string",
          "enum": [
            "referenced",
            "all"
          ],
          "default": "referenced",
          "markdownDescription": "Which objects get generated stubs. `referenced` (default, lean): only objects used in your code get full stubs — tens of files, minimal CPU/IO. `all`: additionally writes lightweight type-only stubs for every org object (heavier; thousands of files) so any object resolves and is discoverable by AI."
        },
        "adure-sfx-toolkit.apex.generateSObjectStubs": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generate SObject schema stubs into `.sfdx/tools/sobjects` in the background so the Salesforce Apex Language Server recognizes objects its own refresh skips (custom metadata types, platform events, namespaced objects) and so AI tooling can discover the schema. Full field stubs are written for objects referenced in your code; lightweight type-only stubs for the rest. Salesforce-generated stubs for objects you use are **extended** with any missing fields (inside a delimited, re-runnable region; Salesforce's own content is preserved). Regenerated after org switch, pull, and Refresh Metadata."
        },
        "adure-sfx-toolkit.parallelDeletes": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "description": "Number of parallel API calls when deleting logs."
        },
        "adure-sfx-toolkit.testRunTimeoutMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "description": "Timeout in minutes for running local tests."
        },
        "adure-sfx-toolkit.autoSaveBeforePush": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save all files before pushing source."
        },
        "adure-sfx-toolkit.httpTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "HTTP request timeout in milliseconds."
        },
        "adure-sfx-toolkit.warnOnProductionOrg": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation dialog before deploying metadata, pushing source, or executing Apex against a non-sandbox org (production, Developer Edition, or Dev Hub)."
        },
        "adure-sfx-toolkit.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send anonymous usage telemetry (which features are used, success/failure rates, durations) to help prioritize development. No code, queries, org details, or personal data are ever collected. This setting also respects VS Code's global `#telemetry.telemetryLevel#` — disabling either one turns telemetry off.",
          "tags": [
            "telemetry"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.js --production",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package",
    "test:unit": "npm run compile && mocha --reporter spec --timeout 15000 \"out/test/**/*.test.js\"",
    "test:server": "npm run compile && mocha --reporter spec --timeout 15000 out/test/languageServer.test.js out/test/sobjectStubSync.test.js out/test/soqlValidate.test.js out/test/nameMatch.test.js out/test/apexLogParse.test.js out/test/soqlError.test.js out/test/soqlEdit.test.js",
    "bundle": "node esbuild.js --production",
    "bundle:dev": "node esbuild.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.41.0",
    "mocha": "^10.8.2",
    "typescript": "^5.1.3",
    "vscode-jsonrpc": "^9.0.0"
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "5.0.0",
    "@salesforce/soql-language-server": "1.1.0",
    "@vscode/extension-telemetry": "^1.5.2",
    "fast-xml-parser": "^5.9.3",
    "glob": "^8.1.0",
    "minimatch": "^10.2.5",
    "monaco-editor": "^0.52.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}

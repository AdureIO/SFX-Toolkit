{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "out",
		/* No "DOM": the extension host is Node. DOM's globals (e.g. reportError, fetch
		   overloads) would hide missing imports. Browser bundles are checked by
		   tsconfig.webview.json instead. */
		"lib": [
			"ES2020"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		"skipLibCheck": true
	},
	"exclude": [
		"node_modules",
		".vscode-test",
		"server",
		"spike",
		/* Browser (webview) entry points — bundled by esbuild, type-checked with DOM by tsconfig.webview.json */
		"src/webview/objectVisualizer.ts",
		"src/webview/processMap.ts"
	]
}
